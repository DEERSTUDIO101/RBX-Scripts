			local tool = nil
			for _ = 1, 25 do
				task.wait(0.1)
				tool = findCouchTool()
				if tool then break end
			end

			myHum.Sit = false
			task.wait(0.15)
			myRoot.CFrame = origCF

			S.antiSit = wasAntiSit
			if wasAntiSit then
				myHum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
			end

			return tool
		end

		local function flyTeleport(targetCF)
			local myChar = getChar()
			local myRoot = getRoot()
			local myHum  = getHum()
			if not myChar or not myRoot or not myHum then return end

			local startCF = myRoot.CFrame
			local distance = (targetCF.Position - startCF.Position).Magnitude
			
			-- Move in steps of max 40 studs to allow perfect replication of seated player
			local stepDist = 40
			local steps = math.max(1, math.ceil(distance / stepDist))
			
			local wasPlatformStand = myHum.PlatformStand
			myHum.PlatformStand = true
			
			for i = 1, steps do
				local alpha = i / steps
				local nextCF = startCF:lerp(targetCF, alpha)
				
				-- Zero out all assembly velocities to keep everything stable and welded
				for _, p in ipairs(myChar:GetChildren()) do
					if p:IsA("BasePart") then
						p.AssemblyLinearVelocity = Vector3.zero
						p.AssemblyAngularVelocity = Vector3.zero
					end
				end
				
				myRoot.CFrame = nextCF
				RunService.Heartbeat:Wait()
			end
			
			myRoot.CFrame = targetCF
			myHum.PlatformStand = wasPlatformStand
		end


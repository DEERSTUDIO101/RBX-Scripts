		Icon     = "gauge",
		Min      = 10,
		Max      = 300,
		Default  = 10,
		Callback = function(v) flySpeed = v end
	})

	Toggles.Fly = LocalTab:AddToggle({
		Title    = "Fly",
		Subtitle = "WASD + Space/LCtrl to fly (Smooth)",
		Icon     = "wind",
		Default  = false,
		Callback = function(on)
			S.fly = on
			local c = getChar()
			local root = getRoot()
			local hum = getHum()

			if on and c and root and hum then
				-- Setup anchored fly reference part
				flyPart = flyPart or Instance.new("Part")
				flyPart.Size = Vector3.new(1, 1, 1)
				flyPart.Transparency = 1
				flyPart.Anchored = true
				flyPart.CanCollide = false
				flyPart.CFrame = root.CFrame
				flyMoveDir.Value = CFrame.new(0, 0, 0)
				hum.PlatformStand = true

				S.flyConn = RunService.Heartbeat:Connect(function()
					if not S.fly or not c or not c.Parent or not root or not hum then
						if S.flyConn then S.flyConn:Disconnect() S.flyConn = nil end
						if hum then hum.PlatformStand = false end
						return
					end

					local cam = workspace.CurrentCamera
					local x, y, z = 0, 0, 0

					if UIS:IsKeyDown(Enum.KeyCode.W) then z = -1 * flySpeed end
					if UIS:IsKeyDown(Enum.KeyCode.S) then z = 1 * flySpeed end
					if UIS:IsKeyDown(Enum.KeyCode.A) then x = -1 * flySpeed end
					if UIS:IsKeyDown(Enum.KeyCode.D) then x = 1 * flySpeed end
					if UIS:IsKeyDown(Enum.KeyCode.Space) then y = 1 * flySpeed end
					if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then y = -1 * flySpeed end

					-- Point part towards camera view
					flyPart.CFrame = CFrame.new(
						flyPart.CFrame.Position,
						(cam.CFrame * CFrame.new(0, 0, -2048)).Position
					)

					-- Zero out velocities to prevent gravity drop/physics lag
					for _, p in ipairs(c:GetChildren()) do
						if p:IsA("BasePart") then
							p.AssemblyLinearVelocity = Vector3.zero
							p.AssemblyAngularVelocity = Vector3.zero
						end
					end

					-- Interpolate direction for incredible smoothness
					local targetDir = CFrame.new(x, y, z)
					flyMoveDir.Value = flyMoveDir.Value:lerp(targetDir, flySmoothness)
					
					flyPart.CFrame = flyPart.CFrame:lerp(flyPart.CFrame * flyMoveDir.Value, flySmoothness)
					root.CFrame = flyPart.CFrame
					hum.PlatformStand = true
				end)
			else
				if S.flyConn then S.flyConn:Disconnect() S.flyConn = nil end
				if hum then hum.PlatformStand = false end
				if c then
					for _, p in ipairs(c:GetChildren()) do
						if p:IsA("BasePart") then
							p.AssemblyLinearVelocity = Vector3.zero
							p.AssemblyAngularVelocity = Vector3.zero
						end
					end
				end
			end
			notify("Fly", on and "Enabled" or "Disabled", on and "check" or "x")
		end,
	})

	LocalTab:AddSeparator()
	LocalTab:AddLabel("Freecam", "video")
	LocalTab:AddSeparator()

	LocalTab:AddSlider({
		Title    = "Freecam Speed",
		Icon     = "gauge",
		Min      = 1,
		Max      = 100,
		Default  = 5,
		Callback = function(v) S.freecamSpeed = v end
	})

	local freecamToggle
	freecamToggle = LocalTab:AddToggle({
		Title    = "Freecam",
		Subtitle = "WASD + Q/E to fly camera (Smooth)",
		Icon     = "camera",
		Default  = false,
		Callback = function(on)
			S.freecamActive = on
			local cam = workspace.CurrentCamera
			local char = LP.Character
			local root = getRoot()

			local function flyEnd()
				if S.freecamConn then S.freecamConn:Disconnect(); S.freecamConn = nil end
				if S.freecamInputBegin then S.freecamInputBegin:Disconnect(); S.freecamInputBegin = nil end
				if S.freecamInputEnd then S.freecamInputEnd:Disconnect(); S.freecamInputEnd = nil end

				cam.CameraSubject = getHum() or char
				pcall(function()
					if root then root.Anchored = false end
				end)
			end

			if not on then
				flyEnd()
				notify("Freecam", "Disabled", "x")
				return
			end

			local dir = {w = false, a = false, s = false, d = false, q = false, e = false}
			S.freecamMoveDir.Value = CFrame_new(0,0,0)

			S.freecamPart = S.freecamPart or Instance_new("Part")
			S.freecamPart.Transparency = 1
			S.freecamPart.Anchored = true
			S.freecamPart.CanCollide = false
			S.freecamPart.Size = Vector3_new(1, 1, 1)
			S.freecamPart.CFrame = cam.CFrame
			pcall(function()
				if root then root.Anchored = true end
			end)

			S.freecamConn = RunService.RenderStepped:Connect(function()
				if not S.freecamActive or not cam or not S.freecamPart then
					flyEnd()
					if freecamToggle then freecamToggle:Set(false) end
					return
				end

				local speed = S.freecamSpeed
				local x, y, z = 0, 0, 0
				if dir.w then z = -1 * speed end
				if dir.a then x = -1 * speed end
				if dir.s then z = 1 * speed end
				if dir.d then x = 1 * speed end
				if dir.q then y = -1 * speed end -- Down
				if dir.e then y = 1 * speed end  -- Up

				cam.CameraSubject = S.freecamPart

				S.freecamPart.CFrame = CFrame_new(
					S.freecamPart.CFrame.Position,
					(cam.CFrame * CFrame_new(0, 0, -100)).Position
				)

				local moveDir = CFrame_new(x, y, z)
				S.freecamMoveDir.Value = S.freecamMoveDir.Value:lerp(moveDir, S.freecamSmoothness)
				S.freecamPart.CFrame = S.freecamPart.CFrame:lerp(S.freecamPart.CFrame * S.freecamMoveDir.Value, S.freecamSmoothness)
			end)

			S.freecamInputBegin = UIS.InputBegan:Connect(function(input, event)
				if event then return end
				local code, codes = input.KeyCode, Enum.KeyCode
				if code == codes.W then
					dir.w = true
				elseif code == codes.A then
					dir.a = true
				elseif code == codes.S then
					dir.s = true
				elseif code == codes.D then
					dir.d = true
				elseif code == codes.Q then
					dir.q = true
				elseif code == codes.E then
					dir.e = true
				end
			end)

			S.freecamInputEnd = UIS.InputEnded:Connect(function(input, event)
				if event then return end
				local code, codes = input.KeyCode, Enum.KeyCode
				if code == codes.W then
					dir.w = false
				elseif code == codes.A then
					dir.a = false
				elseif code == codes.S then
					dir.s = false
				elseif code == codes.D then
					dir.d = false
				elseif code == codes.Q then
					dir.q = false
				elseif code == codes.E then
					dir.e = false
				end
			end)

			notify("Freecam", "Enabled", "check")
		end,
	})

	LocalTab:AddToggle({
		Title    = "Anti-AFK",
		Subtitle = "Prevent AFK kick",
		Icon     = "shield",
		Default  = false,
		Callback = function(on)
			if on then
				local vu = LP:FindFirstChildOfClass("VirtualUser") or Instance.new("VirtualUser", LP)
				LP.Idled:Connect(function() vu:CaptureController(); vu:ClickButton2(Vector2.new()) end)
			end
			notify("Anti-AFK", on and "Enabled" or "Disabled", on and "check" or "x")
		end,
	})
end

-- ════════════════════════════════════════════════════════
-- ESP
-- Drawing.Transparency: 0 = fully opaque, 1 = invisible
-- Cache: plr → { char, billboard, distLabel, bones[], snapLine }
-- ════════════════════════════════════════════════════════
do
	-- Check Drawing API once and cache it in getgenv
	local ohDrawOK = getgenv().ohDrawOK
	local ohTextOK = getgenv().ohTextOK
	if ohDrawOK == nil then
		ohDrawOK = false
		ohTextOK = false
		pcall(function()
			local ln = Drawing.new("Line")
			ohDrawOK = true
			pcall(function() ln:Remove() end)
			pcall(function() ln:Destroy() end)
		end)
		if ohDrawOK then
			pcall(function()
				local tx = Drawing.new("Text")
				ohTextOK = true
				pcall(function() tx:Remove() end)
				pcall(function() tx:Destroy() end)
			end)
		end
		getgenv().ohDrawOK = ohDrawOK
		getgenv().ohTextOK = ohTextOK
	end

	-- Clean up old cache on re-exec to prevent ghost drawings
	if getgenv().ohESPCache then
		for _, e in pairs(getgenv().ohESPCache) do
			pcall(function() if e.billboard then e.billboard:Destroy() end end)
			if e.bones then for _, b in ipairs(e.bones) do pcall(function() b.line:Remove() b.line:Destroy() end) end end
			pcall(function() if e.snapLine then e.snapLine:Remove() e.snapLine:Destroy() end end)
			pcall(function() if e.distLabel then e.distLabel:Remove() e.distLabel:Destroy() end end)
			pcall(function() if e.nameLabel then e.nameLabel:Remove() e.nameLabel:Destroy() end end)
			pcall(function() if e.toolLabel then e.toolLabel:Remove() e.toolLabel:Destroy() end end)
			pcall(function() if e.highlight then e.highlight:Destroy() end end)
			pcall(function() if e.box then e.box:Remove() e.box:Destroy() end end)
			pcall(function() if e.healthBar then e.healthBar:Remove() e.healthBar:Destroy() end end)
			pcall(function() if e.healthBg then e.healthBg:Remove() e.healthBg:Destroy() end end)
		end
	end
	getgenv().ohESPCache = {}
	local cache = getgenv().ohESPCache

	local BONE_R6 = {
		{"Head","Torso"},
		{"Torso","Left Arm"},  {"Torso","Right Arm"},
		{"Torso","Left Leg"},  {"Torso","Right Leg"},
	}
	local BONE_R15 = {
		{"Head","UpperTorso"},
		{"UpperTorso","LowerTorso"},
		{"LowerTorso","LeftUpperLeg"},  {"LeftUpperLeg","LeftLowerLeg"},   {"LeftLowerLeg","LeftFoot"},
		{"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"}, {"RightLowerLeg","RightFoot"},
		{"UpperTorso","LeftUpperArm"},  {"LeftUpperArm","LeftLowerArm"},   {"LeftLowerArm","LeftHand"},
		{"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"},
	}

	local function safeRemove(obj)
		if not obj then return end
		pcall(function() obj:Remove() end)
		pcall(function() obj:Destroy() end)
	end

	local function newLine()
		if not ohDrawOK then return nil end
		local ok, ln = pcall(function()
			local l = Drawing.new("Line")
			l.Thickness    = 1.5
			l.Color        = S.espColor
			l.Transparency = 1.0 -- 1.0 is fully visible (opaque)
			l.Visible      = false
			return l
		end)
		return ok and ln or nil
	end

	local function newText()
		if not ohTextOK then return nil end
		local ok, t = pcall(function()
			local tx = Drawing.new("Text")
			tx.Size         = 13
			tx.Color        = S.espColor
			tx.Transparency = 1.0 -- 1.0 is fully visible (opaque)
			tx.Outline      = true
			tx.OutlineColor = Color3.new(0,0,0)
			tx.Visible      = false
			return tx
		end)
		return ok and t or nil
	end

	local function newSquare()
		if not ohDrawOK then return nil end
		local ok, sq = pcall(function()
			local s = Drawing.new("Square")
			s.Thickness    = 1.5
			s.Color        = S.espColor
			s.Transparency = 1.0
			s.Filled       = false
			s.Visible      = false
			return s
		end)
		return ok and sq or nil
	end

	local function newCircle()
		if not ohDrawOK then return nil end
		local ok, ci = pcall(function()
			local c = Drawing.new("Circle")
			c.Thickness    = 1
			c.Color        = S.espColor
			c.Transparency = 1.0
			c.Filled       = true
			c.Visible      = false
			return c
		end)
		return ok and ci or nil
	end

	local function removeCacheEntry(plr)
		local e = cache[plr]; if not e then return end
		pcall(function() if e.billboard then e.billboard:Destroy() end end)
		if e.bones then for _, b in ipairs(e.bones) do safeRemove(b.line) end end
		safeRemove(e.snapLine)
		safeRemove(e.distLabel)
		safeRemove(e.nameLabel)
		safeRemove(e.toolLabel)
		pcall(function() if e.highlight then e.highlight:Destroy() end end)
		safeRemove(e.box)
		safeRemove(e.healthBar)
		safeRemove(e.healthBg)
		cache[plr] = nil
	end

	local function buildCache(plr)
		removeCacheEntry(plr)
		local char = plr.Character; if not char then return end
		local h    = char:FindFirstChildOfClass("Humanoid")
		local isR6 = h and h.RigType == Enum.HumanoidRigType.R6
		
		local entry = { 
			char = char, 
			billboard = nil, 
			billboardLabel = nil,
			bones = {}, 
			snapLine = nil, 
			distLabel = nil, 
			nameLabel = nil,
			toolLabel = nil,
			highlight = nil,
			box = nil,
			healthBar = nil,
			healthBg = nil,
			parts = {},
			isR6 = isR6,
			head = nil,
			root = nil
		}

		-- Cache joint references to avoid calling FindFirstChild in the RenderStepped loop
		local partNames = isR6 and {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "HumanoidRootPart"} or 
		                  {"Head", "UpperTorso", "LowerTorso", 
		                   "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", 
		                   "RightUpperLeg", "RightLowerLeg", "RightFoot", 
		                   "LeftUpperArm", "LeftLowerArm", "LeftHand", 
		                   "RightUpperArm", "RightLowerArm", "RightHand",
		                   "HumanoidRootPart"}
		
		local parts = {}
		for i = 1, #partNames do
			local name = partNames[i]
			parts[name] = char:FindFirstChild(name)
		end
		entry.parts = parts
		entry.head  = parts["Head"]
		entry.root  = parts["HumanoidRootPart"]

		-- Name ESP
		if S.nameESP then
			if ohTextOK then
				entry.nameLabel = newText()
				if entry.nameLabel then
					entry.nameLabel.Center = true
					entry.nameLabel.Size = 16 -- Made a bit larger as requested
				end
			else
				local bb  = Instance.new("BillboardGui")
				bb.Name        = "OH_NameESP"
				bb.Size        = UDim2.new(0, 120, 0, 20)
				bb.StudsOffset = Vector3.new(0, 3.2, 0)
				bb.AlwaysOnTop = true
				bb.Adornee     = entry.head or entry.root or char.PrimaryPart
				local lbl = Instance.new("TextLabel", bb)
				lbl.Size                   = UDim2.new(1,0,1,0)
				lbl.BackgroundTransparency = 1
				lbl.Text                   = plr.Name
				lbl.TextColor3             = S.espColor
				lbl.Font                   = Enum.Font.GothamBold
				lbl.TextSize               = 14 -- Made a bit larger as requested
				lbl.TextStrokeTransparency = 0
				lbl.TextStrokeColor3       = Color3.new(0,0,0)
				
				-- Safe parenting bypasses game character child-added checks
				local parentSuccess = pcall(function()
					bb.Parent = game:GetService("CoreGui") or LP:FindFirstChildOfClass("PlayerGui")
				end)
				if not parentSuccess then
					pcall(function() bb.Parent = char end)
				end
				entry.billboard = bb
				entry.billboardLabel = lbl
			end
		end

		-- Bone lines
		if S.boneESP and ohDrawOK then
			for _, pair in ipairs(isR6 and BONE_R6 or BONE_R15) do
				local ln = newLine()
				if ln then
					table.insert(entry.bones, { line=ln, from=pair[1], to=pair[2] })
				end
			end
		end

		-- Snap line
		if S.snapESP and ohDrawOK then
			entry.snapLine = newLine()
			if entry.snapLine then entry.snapLine.Thickness = 1 end
		end

		-- Distance label
		if S.distESP and ohDrawOK then
			entry.distLabel = newText()
			if entry.distLabel then
				entry.distLabel.Size = 14 -- Made a bit larger as requested
			end
		end

		-- Box ESP
		if S.boxESP and ohDrawOK then
			entry.box = newSquare()
		end

		-- Health ESP
		if S.healthESP and ohDrawOK then
			entry.healthBg = newLine()
			if entry.healthBg then
				entry.healthBg.Thickness = 2.5
				entry.healthBg.Color = Color3_fromRGB(40, 40, 40)
			end
			entry.healthBar = newLine()
			if entry.healthBar then
				entry.healthBar.Thickness = 1.5
			end
		end

		-- Tool ESP
		if S.toolESP and ohTextOK then
			entry.toolLabel = newText()
			if entry.toolLabel then
				entry.toolLabel.Size = 14
				entry.toolLabel.Center = true
			end
		end

		cache[plr] = entry
	end

	local function rebuildAll()
		for plr in pairs(cache) do removeCacheEntry(plr) end
		if not (S.nameESP or S.boneESP or S.snapESP or S.distESP or S.boxESP or S.healthESP or S.chamsESP or S.toolESP) then return end
		for _, plr in pairs(Players:GetPlayers()) do
			if plr ~= LP then pcall(buildCache, plr) end
		end
	end

	-- ─── Update loop (Native FPS, Self-Healing & Leak-Free) ──────────────────
	table.insert(S.conns, RunService.RenderStepped:Connect(function()
		local activeName    = S.nameESP
		local activeBone    = S.boneESP
		local activeSnap    = S.snapESP
		local activeDist    = S.distESP
		local activeBox     = S.boxESP
		local activeHealth  = S.healthESP
		local activeChams   = S.chamsESP
		local activeTool    = S.toolESP

		if not (activeName or activeBone or activeSnap or activeDist or activeBox or activeHealth or activeChams or activeTool) then
			for plr in pairs(cache) do removeCacheEntry(plr) end
			return
		end

		local cam        = workspace.CurrentCamera
		local vp         = cam.ViewportSize
		local myRoot     = getRoot()
		local snapOrigin = Vector2_new(vp.X * 0.5, vp.Y)
		local currentESPColor = S.espColor

		-- 1. Dynamic player cleanup (players who left)
		for plr in pairs(cache) do
			if not plr or not plr:IsDescendantOf(Players) then
				removeCacheEntry(plr)
			end
		end

		-- 2. Update and render active players
		local playersList = Players:GetPlayers()
		for i = 1, #playersList do
			local plr = playersList[i]
			if plr == LP then continue end
			local char = plr.Character
			if not char then
				removeCacheEntry(plr)
				continue
			end

			local e = cache[plr]
			if not e or e.char ~= char then
				pcall(buildCache, plr)
				e = cache[plr]
			end
			if not e then continue end

			-- Set up fast projection caching local variables for this frame
			local parts = e.parts
			local projected = {}
			local projectedInViewport = {}

			local function getProjected(partName)
				local proj = projected[partName]
				if proj ~= nil then return proj, projectedInViewport[partName] end
				local part = parts[partName]
				if not part or part.Parent ~= char then
					part = char:FindFirstChild(partName)
					parts[partName] = part
				end
				if part then
					local p3, inVP = cam:WorldToViewportPoint(part.Position)
					projected[partName] = p3
					projectedInViewport[partName] = inVP
					return p3, inVP
				end
				projected[partName] = false
				projectedInViewport[partName] = false
				return false, false
			end

			local headPart = parts["Head"]
			if not headPart or headPart.Parent ~= char then
				headPart = char:FindFirstChild("Head")
				parts["Head"] = headPart
			end
			if not headPart then continue end

			local hPos3, inViewport = getProjected("Head")
			if not hPos3 then continue end
			local inFront = hPos3.Z > 0

			-- ── Name Billboard Fallback ───────────────────────────────
			local bill = e.billboard
			if bill then
				bill.Enabled = inViewport and activeName
				local lbl = e.billboardLabel
				if lbl then lbl.TextColor3 = currentESPColor end
			end

			-- ── Extremities Projection for Bounding Box ────────────────
			local minX, minY = math.huge, math.huge
			local maxX, maxY = -math.huge, -math.huge
			local anyProjected = false

			if activeBox or activeHealth or activeName or activeDist or activeTool then
				local exList = e.isR6 and {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"} or 
				                          {"Head", "LeftHand", "RightHand", "LeftFoot", "RightFoot", "UpperTorso", "LowerTorso"}

				for j = 1, #exList do
					local p3, inVP = getProjected(exList[j])
					if p3 and p3.Z > 0 then
						anyProjected = true
						if p3.X < minX then minX = p3.X end
						if p3.X > maxX then maxX = p3.X end
						if p3.Y < minY then minY = p3.Y end
						if p3.Y > maxY then maxY = p3.Y end
					end
				end
			end

			local hasBox = anyProjected and (maxX > minX) and (maxY > minY)
			local x, y, width, height = 0, 0, 0, 0
			if hasBox then
				x = math_floor(minX - 4)
				y = math_floor(minY - 4)
				width = math_floor((maxX - minX) + 8)
				height = math_floor((maxY - minY) + 8)
			end

			-- ── Box & Health Bar ─────────────────────────────────────────
			local box   = e.box
			local hBar  = e.healthBar
			local hBg   = e.healthBg
			local showBox = activeBox and box
			local showHealth = activeHealth and hBar and hBg

			if showBox and hasBox and inViewport then
				box.Position = Vector2_new(x, y)
				box.Size     = Vector2_new(width, height)
				box.Color    = currentESPColor
				box.Visible  = true
			else
				if box then box.Visible = false end
			end

			if showHealth and hasBox and inViewport then
				local hum = char:FindFirstChildOfClass("Humanoid")
				local health = hum and hum.Health or 100
				local maxHealth = hum and hum.MaxHealth or 100
				local healthPercent = math.clamp(health / maxHealth, 0, 1)

				local hColor = Color3_fromRGB(0, 255, 0)
				if healthPercent <= 0.3 then
					hColor = Color3_fromRGB(255, 0, 0)
				elseif healthPercent <= 0.7 then
					hColor = Color3_fromRGB(255, 255, 0)
				end

				local barX = x - 6
				hBg.From    = Vector2_new(barX, y)
				hBg.To      = Vector2_new(barX, y + height)
				hBg.Visible = true

				hBar.From    = Vector2_new(barX, y + height)
				hBar.To      = Vector2_new(barX, y + height - (height * healthPercent))
				hBar.Color   = hColor
				hBar.Visible = true
			else
				if hBar then hBar.Visible = false end
				if hBg  then hBg.Visible  = false end
			end

			-- ── Name Label (Drawing) ──────────────────────────────────
			local nLabel = e.nameLabel
			if nLabel then
				if inViewport and activeName then
					nLabel.Text     = plr.Name
					nLabel.Color    = currentESPColor
					if hasBox then
						nLabel.Position = Vector2_new(x + (width * 0.5), y - 18)
					else
						nLabel.Position = Vector2_new(hPos3.X, hPos3.Y - 22)
					end
					nLabel.Visible  = true
				else
					nLabel.Visible  = false
				end
			end

			-- ── Distance & Tool Labels ────────────────────────────────
			local dLabel = e.distLabel
			local tLabel = e.toolLabel

			if inViewport and (activeDist or activeTool) then
				local currentBottomY = hasBox and (y + height + 2) or (hPos3.Y + 12)
				local labelX = hasBox and (x + (width * 0.5)) or hPos3.X

				if activeDist and dLabel then
					local dist = myRoot and math_floor((myRoot.Position - headPart.Position).Magnitude) or 0
					dLabel.Text     = dist .. "m"
					dLabel.Color    = currentESPColor
					dLabel.Center   = true
					dLabel.Position = Vector2_new(labelX, currentBottomY)
					dLabel.Visible  = true
					currentBottomY = currentBottomY + 14
				else
					if dLabel then dLabel.Visible = false end
				end

				if activeTool and tLabel then
					local tool = char:FindFirstChildOfClass("Tool")
					if tool then
						tLabel.Text     = tool.Name
						tLabel.Color    = Color3_fromRGB(240, 240, 240)
						tLabel.Position = Vector2_new(labelX, currentBottomY)
						tLabel.Visible  = true
					else
						tLabel.Visible  = false
					end
				else
					if tLabel then tLabel.Visible = false end
				end
			else
				if dLabel then dLabel.Visible = false end
				if tLabel then tLabel.Visible = false end
			end

			-- ── Chams ESP (Glow) ──────────────────────────────────────
			if activeChams then
				local hl = e.highlight
				if not hl or hl.Parent == nil then
					hl = Instance.new("Highlight")
					hl.Name = "OH_Chams"
					hl.FillColor = currentESPColor
					hl.OutlineColor = currentESPColor
					hl.FillTransparency = 1
					hl.OutlineTransparency = 0
					
					local coreGui = game:GetService("CoreGui")
					local success = pcall(function()
						hl.Parent = coreGui or LP:FindFirstChildOfClass("PlayerGui")
					end)
					if not success then
						pcall(function() hl.Parent = char end)
					end
					e.highlight = hl
				end
				hl.Adornee = char
				hl.OutlineColor = currentESPColor
				hl.Enabled = true
			else
				if e.highlight then
					pcall(function() e.highlight:Destroy() end)
					e.highlight = nil
				end
			end

			-- ── Snap Line ─────────────────────────────────────────────
			local sLine = e.snapLine
			if sLine then
				if inFront and activeSnap then
					local root3, rInViewport = getProjected("HumanoidRootPart")
					if not root3 then
						root3, rInViewport = hPos3, inViewport
					end
					if rInViewport or (root3 and root3.Z > 0) then
						local snapToX = hasBox and (x + width * 0.5) or root3.X
						local snapToY = hasBox and (y + height) or root3.Y
						sLine.From    = snapOrigin
						sLine.To      = Vector2_new(snapToX, snapToY)
						sLine.Color   = currentESPColor
						sLine.Visible = true
					else
						sLine.Visible = false
					end
				else
					sLine.Visible = false
				end
			end

			-- ── Bones ─────────────────────────────────────────────────
			local bonesList = e.bones
			if activeBone and #bonesList == 0 and ohDrawOK then
				pcall(buildCache, plr)
				e = cache[plr]
				if not e then continue end
				bonesList = e.bones
			end
			
			local numBones = #bonesList
			if activeBone and numBones > 0 then
				local expected = e.isR6 and #BONE_R6 or #BONE_R15
				if numBones ~= expected then
					pcall(buildCache, plr)
					e = cache[plr]
					if not e then continue end
					bonesList = e.bones
					numBones = #bonesList
				end

				for bIdx = 1, numBones do
					local info = bonesList[bIdx]
					local pA3, inVPA = getProjected(info.from)
					local pB3, inVPB = getProjected(info.to)
					local lnObj = info.line
					if pA3 and pB3 and pA3.Z > 0 and pB3.Z > 0 then
						lnObj.From    = Vector2_new(pA3.X, pA3.Y)
						lnObj.To      = Vector2_new(pB3.X, pB3.Y)
						lnObj.Color   = currentESPColor
						lnObj.Visible = true
					else
						lnObj.Visible = false
					end
				end
			elseif numBones > 0 then
				for bIdx = 1, numBones do
					bonesList[bIdx].line.Visible = false
				end
			end
		end
	end))


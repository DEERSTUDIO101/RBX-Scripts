				local origCF = myRoot.CFrame
				
				-- Temporarily turn off Anti Fling to allow target connection
				local wasAntiFling = S.antiFling
				S.antiFling = false
				
				-- Teleport to the target with a slight offset behind and tilted forward by 50 degrees
				notify("Couch Kill", "Teleporting behind " .. bhTarget.Name, "info")
				
				local arrived = false
				for i = 1, 12 do
					myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 2.9) * CFrame.Angles(math.rad(-50), 0, 0)
					task.wait(0.04)
					if (myRoot.Position - targetRoot.Position).Magnitude < 10 then
						arrived = true

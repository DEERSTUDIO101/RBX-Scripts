		local function autoGetCouchTool()
			local existing = findCouchTool()
			if existing then return existing end

			local cgt = workspace:FindFirstChild("WorkspaceCom") and workspace.WorkspaceCom:FindFirstChild("003_CouchGiveTool")
			if not cgt then return nil end
			local seat = cgt:FindFirstChildOfClass("Seat")
			if not seat then return nil end

			local myRoot = getRoot()
			local myHum  = getHum()
			if not myRoot or not myHum then return nil end

			local origCF     = myRoot.CFrame
			local wasAntiSit = S.antiSit

			S.antiSit = false

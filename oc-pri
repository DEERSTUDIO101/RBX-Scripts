					end
				end
				
				if not arrived then
					notify("Couch Kill", "Failed to reach target!", "x")
					S.antiFling = wasAntiFling
					return
				end
				
				-- Now equip the couch tool since we are confirmed to be at the target
				if couchTool.Parent == LP.Backpack then
					myHum:EquipTool(couchTool)
				end
				task.wait(0.15)
				
				-- Detect small skin: HRP significantly below normal standing height
				local targetScale = 1
				local sizeVal = targetHum:FindFirstChild("BodyDepthScale") or targetHum:FindFirstChild("HeadScale")
				if sizeVal and sizeVal.Value < 0.85 then targetScale = sizeVal.Value end
				local isSmall = targetScale < 0.85

				local sat = false
				for i = 1, 100 do
					if targetHum.Sit or targetHum.SeatPart then
						sat = true
						for _ = 1, 10 do
							if targetRoot then
								myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 2.9) * CFrame.Angles(math.rad(-50), 0, 0)
							end
							task.wait(0.025)
						end
						break
					end

					local angle = i * 11
					local rad   = math.rad(angle)
					-- Smaller skin → try shorter distances and lower Y offsets
					local baseDist = isSmall and 1.2 or 1.6
					local dist     = baseDist + (i % 6) * 0.35   -- 1.2–2.9 (small) or 1.6–3.35 (normal)
					local xOffset  = math.sin(rad) * dist
					local zOffset  = (isSmall and 1.8 or 2.3) + math.cos(rad) * 0.8
					-- Small skins: sweep Y from -2 to +0.5 to hit their lower HRP
					local yPhase   = math.sin(math.rad(i * 37))
					local yOffset  = isSmall and (yPhase * 1.5 - 0.8) or (yPhase * 0.5)
					-- Small skins: flatter tilt so seat goes down, not forward
					local tilt     = isSmall and (-20 - (i % 5) * 10) or (-35 - (i % 4) * 12)
					myRoot.CFrame = targetRoot.CFrame
						* CFrame.new(xOffset, yOffset, zOffset)
						* CFrame.Angles(math.rad(tilt), 0, 0)
					task.wait(0.02)
				end

				if sat then
					flyTeleport(CFrame.new(0, -900, 0))
					task.wait(0.25)

					-- Disable seat & welds, unequip first to remove couch from workspace
					for _, v in ipairs(couchTool:GetDescendants()) do
						if v:IsA("Seat") or v:IsA("VehicleSeat") then v.Disabled = true end
						if v:IsA("Weld") or v:IsA("ManualWeld") or v:IsA("WeldConstraint") or v:IsA("Snap") then v:Destroy() end
					end
					if myHum.SeatPart then myHum.Sit = false end
					myHum:UnequipTools()
					task.wait(0.1)
					for _, child in ipairs(myChar:GetDescendants()) do
						if child:IsA("Weld") or child:IsA("ManualWeld") or child:IsA("WeldConstraint") or child.Name:find("Weld") then
							child:Destroy()
						end
					end

					-- Heartbeat-Lock: fight any server/client void-push by reasserting origCF every frame
					myRoot.AssemblyLinearVelocity  = Vector3.zero
					myRoot.AssemblyAngularVelocity = Vector3.zero
					myRoot.CFrame = origCF

					local lockActive = true
					local lockConn
					lockConn = RunService.Heartbeat:Connect(function()
						if not lockActive then lockConn:Disconnect(); return end
						local dist = (myRoot.Position - origCF.Position).Magnitude
						if dist > 5 then
							myRoot.CFrame = origCF
							myRoot.AssemblyLinearVelocity  = Vector3.zero
							myRoot.AssemblyAngularVelocity = Vector3.zero
						end
					end)
					task.delay(2.5, function()
						lockActive = false
					end)

					myHum.PlatformStand = false
					S.antiFling = wasAntiFling
					notify("Couch Kill", "Target dropped!", "check")
				else
					myHum:UnequipTools()
					myRoot.CFrame = origCF
					S.antiFling = wasAntiFling
					notify("Couch Kill", "Failed to catch target!", "x")
				end
			end,
		})


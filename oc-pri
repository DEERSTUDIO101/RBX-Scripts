			for _, e in pairs(ohESPCache or {}) do
				pcall(function() if e.billboard then e.billboard:Destroy() end end)
				for _, info in ipairs(e.bones or {}) do pcall(function() info.line:Remove() end) end
				if e.snapLine  then pcall(function() e.snapLine:Remove() end) end
				if e.distLabel then pcall(function() e.distLabel:Remove() end) end
				if e.toolLabel then pcall(function() e.toolLabel:Remove() end) end
				if e.highlight then pcall(function() e.highlight:Destroy() end) end
				if e.box       then pcall(function() e.box:Remove() end) end
				if e.healthBar then pcall(function() e.healthBar:Remove() end) end
				if e.healthBg  then pcall(function() e.healthBg:Remove() end) end
			end
			getgenv().ohESPCache = {}
			Window:Destroy()
		end,
	})
end


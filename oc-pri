		Callback = function(on)
			if on then
				if not spectateTarget then
					notify("Spectate", "No player selected", "x")
					if specToggle then specToggle:Set(false) end
					return
				end
				local h = spectateTarget.Character and spectateTarget.Character:FindFirstChildOfClass("Humanoid")
				if not h then
					notify("Spectate", "No character", "x")
					if specToggle then specToggle:Set(false) end
					return
				end
				workspace.CurrentCamera.CameraSubject = h
				S.spectateTarget = spectateTarget
				
				-- Anchor the local character immediately
				pcall(function()
					local root = getRoot()
					if root then root.Anchored = true end
				end)

				S.spectateConn = RunService.RenderStepped:Connect(function()
					if S.spectateTarget and S.spectateTarget.Character then
						local sh = S.spectateTarget.Character:FindFirstChildOfClass("Humanoid")
						if sh then workspace.CurrentCamera.CameraSubject = sh end
					end
					
					-- Force-anchor local character during spectate
					pcall(function()
						local root = getRoot()
						if root then root.Anchored = true end
					end)
				end)
				notify("Spectate", "Watching: "..S.spectateTarget.Name, "check")
			else
				if S.spectateConn then S.spectateConn:Disconnect(); S.spectateConn = nil end
				S.spectateTarget = nil
				
				-- Unanchor local character on stop
				pcall(function()
					local root = getRoot()
					if root then root.Anchored = false end
				end)

				local myH = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
				if myH then workspace.CurrentCamera.CameraSubject = myH end
				notify("Spectate", "Stopped", "x")
			end
		end,
	})
end

